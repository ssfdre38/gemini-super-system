# =============================================================================
# GEMINI SUPER SYSTEM // ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and customize for your local setup.
# Zero external npm dependencies required. Pure Node.js.

# Host binding: 0.0.0.0 listens across all interfaces (LAN, NetBird Mesh, Tailscale)
GEMINI_BIND_HOST=0.0.0.0

# Network Ports
GEMINI_DASHBOARD_PORT=18880
GEMINI_ANDROID_PORT=41242
GEMMI_AVATAR_PORT=8088
GEMMI_MESH_PORT=18799
GEMMA_LLM_PORT=11436
AG2_DISCORD_PORT=18895

# Local Sovereign LLM Inference (llama-server / llama.cpp / haven-cpp)
GEMMA_LLM_URL=http://127.0.0.1:11436/v1
GEMMA_LLM_MODEL=gemma-4

# Optional: Custom Paths to 3D Assets and Mobile APKs
# GEMMI_VISUALIZER_HTML=/path/to/gemmi_4d_avatar_visualizer.html
# GEMMI_MODELS_DIR=/path/to/models
# GEMMI_APK_PATH=/path/to/app-debug.apk
# GEMINI_VAULT_PATH=/path/to/gemini_vault.hmb
